{
	# Redirecting HTTP to HTTPS is what a public site wants (CADDY_AUTO_HTTPS=on), but
	# locally the redirect would point at port 443 while the proxy is published on another.
	auto_https {$CADDY_AUTO_HTTPS:disable_redirects}
}

{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	header {
		# 0 tells a browser to forget any earlier HSTS for the name, which is what
		# "localhost" must get: pinning it would also break Moodle's plain http port.
		# A public site sets HSTS_MAX_AGE=31536000.
		Strict-Transport-Security "max-age={$HSTS_MAX_AGE:0}"
		# Same as CloudFront (infra/terraform/cdn.tf): links leak only the origin, and no device access.
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	# The API, under the prefix the frontend already calls it by. The proxy overwrites
	# X-Forwarded-For with the address it saw, so a client cannot pick its own.
	handle_path /api/* {
		# Looks the name up again, so containers added or removed by scaling are picked up.
		reverse_proxy {
			dynamic a backend 8000 {
				refresh 5s
			}
			lb_policy round_robin
		}
	}

	handle {
		reverse_proxy frontend:5173
	}
}
