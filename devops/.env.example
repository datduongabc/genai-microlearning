# Ban mau cua devops/.env. Chep thanh devops/.env roi dien gia tri that.
# Tep .env that KHONG BAO GIO duoc commit, xem .gitignore o thu muc goc.
#
# Day la tep .env DUY NHAT cua du an: docker compose doc no, va backend chay tren
# may that cung doc chinh no (xem backend/app/config.py). Truoc day con mot ban
# thu hai o backend/.env chep lai 23 bien giong het, va hai ban da lech nhau.
#
# Mat khau nen chi gom chu va so. Mot ky tu nhu @ trong mat khau phai duoc ma hoa
# thanh %40 khi nhet vao chuoi ket noi, va do chinh la cho da tung sai.

# --- Co so du lieu ung dung -------------------------------------------------
# Chu so huu schema, dung cho migration va test.
DATABASE_USER=datduongabc
DATABASE_PASSWORD=
# DATABASE_NAME phai co, vi docker-compose.yml doc POSTGRES_DB tu bien nay.
# Neu de trong, Postgres se lay ten database bang ten user.
DATABASE_NAME=microlearning
DATABASE_URL=postgresql+psycopg://datduongabc:<mat-khau>@127.0.0.1:5432/microlearning
DATABASE_URL_DOCKER=postgresql+psycopg://datduongabc:<mat-khau>@db:5432/microlearning

# --- Hai vai tro han che quyen, phuc vu Row Level Security -------------------
# Ung dung web chay bang app_runtime, worker chay bang app_worker. Ca hai deu
# khong phai chu so huu bang nen khong the tu vo hieu hoa policy RLS.
APP_RUNTIME_DB_USER=app_runtime
APP_RUNTIME_DB_PASSWORD=
APP_RUNTIME_DB_NAME=microlearning
APP_RUNTIME_DATABASE_URL=postgresql+psycopg://app_runtime:<mat-khau>@127.0.0.1:5432/microlearning
APP_RUNTIME_DATABASE_URL_DOCKER=postgresql+psycopg://app_runtime:<mat-khau>@db:5432/microlearning
APP_WORKER_DB_USER=app_worker
APP_WORKER_DB_PASSWORD=
APP_WORKER_DB_NAME=microlearning
APP_WORKER_DATABASE_URL=postgresql+psycopg://app_worker:<mat-khau>@127.0.0.1:5432/microlearning
APP_WORKER_DATABASE_URL_DOCKER=postgresql+psycopg://app_worker:<mat-khau>@db:5432/microlearning

# --- Khoa ky JWT ------------------------------------------------------------
# Sinh bang: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Khoa nha cung cap mo hinh ----------------------------------------------
# Chi container gateway doc nhung bien nay. Backend khong bao gio thay chung,
# no chi biet LLM_GATEWAY_KEY va ten alias mo hinh.
# Moi model (Gemini mac dinh, Claude, GPT, GPT-OSS, Llama, Qwen, MiniMax, Whisper,
# embed-openai) di qua OpenRouter: mot khoa, mot so du. https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
LLM_GATEWAY_KEY=
# Experiment mode: see docs/gateway-routing.md#experiments before generating study modules.
LLM_EXPERIMENT_MODE=false
# Khoa gateway dung de goi container model nhung tai cho (service embedder). Chi
# gateway va embedder doc bien nay. Thieu no thi gateway gui OPENAI_API_KEY sang
# day thay vao. Sinh bang: python -c "import secrets; print(secrets.token_urlsafe(32))"
EMBEDDER_API_KEY=

# --- Rerank ----------------------------------------------------------------
# jev (mac dinh, da duoc dong y ngay 2026-11-08): goi API TypeSafe, gui cau hoi
# va doan tai lieu ra ngoai truong, can TYPESAFE_API_KEY. jina: service reranker
# trong stack, khong gui gi ra ngoai.
RERANKER_PROVIDER=jev
TYPESAFE_API_KEY=

# --- Moodle -----------------------------------------------------------------
MOODLE_WWWROOT=http://localhost:8081
# Dia chi backend dung de goi Moodle khi chay tren may that. Trong container thi
# docker-compose.yml dat thang MOODLE_BASE_URL=http://moodle:80.
MOODLE_BASE_URL=http://localhost:8081
MOODLE_SITE_NAME=Microlearning LMS
# Token web service ma backend dung de goi Moodle. Container Moodle tu tao
# token nay luc khoi dong lan dau, xem devops/moodle/configure-webservice.php.
MOODLE_TOKEN=
# Khoa RSA rieng cua cong cu LTI, dang PEM tren mot dong (xuong dong viet thanh \n).
# Co khoa thi worker doc danh sach lop tu LMS (Names and Role Provisioning) va go sinh vien
# da roi lop; de rong thi tat. Sinh bang:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | awk 1 ORS='\\n'
LTI_PRIVATE_KEY=
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=
MOODLE_ADMIN_EMAIL=
MOODLE_DB_TYPE=pgsql
MOODLE_DB_HOST=db
MOODLE_DB_PORT=5432
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=

# So nhan CPU cho service reranker (mac dinh 4). Dat nho hon tren may it hon 4 nhan,
# vi Docker tu choi so nhan lon hon so may co.
# RERANKER_CPUS=2

# Module generations per UTC day for accounts without a currently authorized linked Moodle course.
NON_TEACHER_DAILY_GENERATION_LIMIT=3

# So job moi container worker chay cung luc.
WORKER_POOL_SIZE=4
# So cau hoi cua mot module sinh cung luc.
QUESTION_CONCURRENCY=5
# So request rerank mot process gui cung luc. Tang khi co them container reranker.
RERANKER_MAX_CONCURRENT=2
