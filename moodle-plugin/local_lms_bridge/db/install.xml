<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/lms_bridge/db" VERSION="20261008" COMMENT="Moodle account confirmation requests"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
 <TABLES><TABLE NAME="local_lms_bridge_requests" COMMENT="Requests awaiting consent from their Moodle owner">
