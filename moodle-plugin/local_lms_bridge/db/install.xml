 </FIELDS><KEYS><KEY NAME="primary" TYPE="primary" FIELDS="id"/></KEYS>
 <INDEXES><INDEX NAME="requestid" UNIQUE="true" FIELDS="requestid"/></INDEXES>
 </TABLE></TABLES></XMLDB>
